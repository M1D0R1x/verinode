# ==============================================================================
# Verinode — Local Environment Configuration Template
# ==============================================================================

# Core Application Environment
ENV=development
LOG_LEVEL=debug
APP_PORT=8080
PUBLIC_API_URL=http://localhost:8080/v1
WEB_APP_URL=http://localhost:3000

# PostgreSQL (Authoritative Transactional & Outbox Store)
DATABASE_URL=postgres://verinode:verinode_dev_secret@localhost:5432/verinode?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis (Caching & Distributed Locks Only - Never Authoritative Balances)
REDIS_URL=redis://localhost:6379/0

# ClickHouse (Telemetry & Canary Benchmark Time-Series Store)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=verinode_dev_secret
CLICKHOUSE_DB=verinode_telemetry

# Temporal Orchestration Cluster
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Object Storage (S3 / MinIO for Signed PDFs and Attestation Bundles)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=verinode-evidence
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_USE_SSL=false

# Authentication & Enterprise SSO
AUTH_JWT_SECRET=super-secure-local-jwt-secret-key-at-least-32-chars
OIDC_ISSUER_URL=https://auth.verinode.local
OIDC_CLIENT_ID=verinode-web-client
OIDC_CLIENT_SECRET=dev-client-secret

# Third-Party Integrations (Sandboxes - Buy vs. Build)
KYC_VENDOR_API_KEY=sandbox_kyc_key_placeholder
ESIGN_PROVIDER_API_KEY=sandbox_esign_key_placeholder
BANK_SANDBOX_API_KEY=sandbox_bank_key_placeholder

# Market Data / Index Calculation Service (Separated Trust Domain)
INDEX_SERVICE_DATABASE_RO_URL=postgres://verinode_ro:verinode_dev_secret@localhost:5432/verinode?sslmode=disable
INDEX_PUBLISHER_PRIVATE_KEY=dev_ed25519_private_key_placeholder
